{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/milestones",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/tax-deadline-reminder",
      "schedule": "0 14 12,26 * *"
    },
    {
      "path": "/api/cron/zero-activity-check",
      "schedule": "0 14 7 * *"
    }
  ]
}
